# =====================================================================
# .gitignore del frontend PLANTA (Angular + Tailwind + daisyUI + Dexie PWA)
# =====================================================================

# ---------- Dependencias ----------
/node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Compilacion y cache de Angular ----------
/dist/
/out-tsc/
/tmp/
/.angular/
/.sass-cache/
*.tsbuildinfo

# ---------- Archivos generados al arrancar / compilar ----------
# Los crea scripts/generate-version.js (prestart / prebuild) a partir de la "version" del package.json.
/src/app/version.ts
/public/sw-version.js

# ---------- Pruebas y cobertura ----------
/coverage/
/.nyc_output/
/cypress/videos/
/cypress/screenshots/
/playwright-report/
/test-results/

# ---------- Variables de entorno y secretos ----------
# Configuracion propia de cada equipo / servidor (URL de la API, etc.): NO se versiona.
# Lo que si se sube son las plantillas *.example.ts (copiarlas como environment.ts y environment.prod.ts).
/src/environments/environment.ts
/src/environments/environment.prod.ts
.env
.env.*
!.env.example
*.pem
*.key
*.pfx

# ---------- Logs ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ---------- Editor / IDE ----------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.sublime-workspace
*.swp
*.swo
*~

# ---------- Sistema operativo / sistema de archivos ----------
.DS_Store
Thumbs.db
desktop.ini
.fuse_hidden*

# ---------- Varios ----------
*.bak
*.tmp
.claude/
